# =============================================================================
# MarketMotion AI — Environment Variables (.env.example)
# Copy to `.env` for local development or configure in Vercel Project Settings.
# Never commit actual secrets or API keys to version control.
# =============================================================================

# --- Google Gemini AI (Server-Only, Required for Content Generation) ---------
# Used by /api/ai/parse-article, /api/ai/generate-scripts,
# /api/ai/generate-storyboard, and /api/ai/generate-publishing
GEMINI_API_KEY="your_gemini_api_key_here"
# Optional Gemini model override (defaults to gemini-2.5-flash)
GEMINI_MODEL="gemini-2.5-flash"

# --- Firebase Web Client & Cloud Firestore (Public Build-Time Overrides) -----
# Falls back automatically to firebase-applet-config.json ("stunning-casing-qpz3c") if omitted
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# --- Application Metadata ----------------------------------------------------
APP_URL="https://marketmotion-ai.vercel.app"
